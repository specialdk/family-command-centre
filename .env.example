# Copy this file to .env for local development.
# NEVER commit .env to GitHub.

# Local PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/family_command_centre?schema=public"
DATABASE_URL=""

# Password required to open the Family Command Centre.
APP_PASSWORD="change-me"

# Long random value used to sign the login cookie.
# Generate locally with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET="replace-with-a-long-random-secret"

# Local development front-end origin.
WEB_ORIGIN="http://localhost:5173"

# Railway provides PORT automatically.
PORT="3000"
