// DRAFT — proposed replacement for schema.prisma. Not wired up yet.
// Designed so the Calendar module and Microsoft Graph sync can be built once
// rather than twice. Deliberately does NOT model Finances, Investments,
// Recipes or Ideas: those are cheap to add later, whereas getting Event and
// Task wrong is expensive.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum MemberRole {
  PARENT
  CHILD
  OTHER
}

/// Where a record came from. Drives sync behaviour and conflict handling.
enum Source {
  LOCAL
  MICROSOFT
  GOOGLE
}

/// How much of an event other family members may see.
/// BUSY renders as "Busy - Rhian" with no detail: the privacy rule from the
/// handover, so work calendars can sync without exposing their contents.
enum Visibility {
  FULL
  BUSY
  PRIVATE
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

/// Chores are recurring tasks, not a separate thing. Rhian's own UI shows
/// them together under "Tasks & routines".
enum TaskKind {
  TASK
  CHORE
  ROUTINE
}

// --------------------------------------------------------------- people

model FamilyMember {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  initials  String
  role      MemberRole @default(OTHER)
  /// Maps to the CSS custom property: rhian | danielle | lachie | jack | maddie | family
  colorKey  String?
  /// How the name is said, for text-to-speech only - never shown. Rhian is
  /// "Ryan", Danielle is "Dan-eel". An English speech engine reads the
  /// letters and gets both wrong, and a family app that mispronounces the
  /// family is not one anybody keeps using. Null means the spelling is fine.
  pronunciation String?
  /// Microsoft sign-in address. Null for members who do not sign in.
  email     String?    @unique
  canSignIn Boolean    @default(false)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  calendars        Calendar[]
  events           Event[]
  tasks            Task[]
  taskLists        TaskList[]
  externalAccounts ExternalAccount[]
  activity         ActivityLog[]
  shoppingAdded    ShoppingItem[]
  noticesFor       Notification[]     @relation("NoticeFor")
  noticesBy        Notification[]     @relation("NoticeBy")
  noticeReads      NotificationRead[]
  pushSubscriptions PushSubscription[]
  reminderLogs      ReminderLog[]
}

/// One per connected provider account. Tokens are encrypted at rest with
/// TOKEN_ENCRYPTION_KEY, following the pattern Rhian already established.
model ExternalAccount {
  id                Int          @id @default(autoincrement())
  memberId          Int
  member            FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  provider          Source
  providerAccountId String
  accessTokenEnc    String?
  refreshTokenEnc   String?
  expiresAt         DateTime?
  scopes            String?
  connectedAt       DateTime     @default(now())

  @@unique([provider, providerAccountId])
}

// ------------------------------------------------------------- calendar

/// A person may have several (personal, work, shared family). Separate
/// calendars are what make per-calendar privacy possible.
model Calendar {
  id                Int           @id @default(autoincrement())
  name              String
  /// Null means a shared family calendar.
  memberId          Int?
  member            FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  source            Source        @default(LOCAL)
  externalId        String?
  color             String?
  syncEnabled       Boolean       @default(true)
  defaultVisibility Visibility    @default(FULL)
  /// Microsoft Graph delta token, so each sync fetches only what changed.
  deltaToken        String?
  lastSyncedAt      DateTime?
  createdAt         DateTime      @default(now())

  events Event[]

  @@unique([source, externalId])
}

model Event {
  id         Int           @id @default(autoincrement())
  calendarId Int
  calendar   Calendar      @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  memberId   Int?
  member     FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  title    String
  location String?
  notes    String?
  startsAt DateTime
  endsAt   DateTime
  allDay   Boolean  @default(false)
  /// IANA zone, e.g. Australia/Adelaide. Needed once events cross zones.
  timeZone String?

  /// RFC 5545 RRULE on the series parent; expanded at read time.
  recurrenceRule      String?
  recurrenceParentId  Int?
  recurrenceParent    Event?  @relation("EventRecurrence", fields: [recurrenceParentId], references: [id], onDelete: Cascade)
  recurrenceInstances Event[] @relation("EventRecurrence")
  /// Set on an instance that was moved, so the series knows which one it replaces.
  originalStartsAt    DateTime?
  cancelled           Boolean @default(false)
  /// Minutes before startsAt to send a reminder. Null = family default.
  reminderMins Int?
  visibility   Visibility @default(FULL)
  source       Source     @default(LOCAL)
  externalId   String?
  externalEtag String?
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([startsAt, endsAt])
  @@index([memberId, startsAt])
}

// ---------------------------------------------------------------- tasks

/// Microsoft To Do has user-defined lists, so this cannot stay an enum.
model TaskList {
  id         Int           @id @default(autoincrement())
  name       String
  source     Source        @default(LOCAL)
  externalId String?
  memberId   Int?
  member     FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  sortOrder  Int           @default(0)
  createdAt  DateTime      @default(now())

  tasks Task[]

  @@unique([source, externalId])
}

model Task {
  id       Int           @id @default(autoincrement())
  title    String
  notes    String?
  kind     TaskKind      @default(TASK)
  status   TaskStatus    @default(OPEN)
  listId   Int?
  list     TaskList?     @relation(fields: [listId], references: [id], onDelete: SetNull)
  memberId Int?
  member   FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  dueAt DateTime?
  /// When it was dragged onto someone's day. Distinct from dueAt: "do it
  /// Saturday morning" is not the same as "it is due Saturday".
  scheduledFor DateTime?
  durationMins Int?
  completedAt  DateTime?
  /// The "Need help" column in Rhian's Tasks board.
  needsHelp    Boolean   @default(false)
  /// Minutes before scheduledFor (or dueAt) to send a reminder. Null = family default.
  reminderMins Int?
  recurrenceRule String?
  position       Int     @default(0)

  source       Source    @default(LOCAL)
  externalId   String?
  externalEtag String?
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, externalId])
  @@index([status, dueAt])
  @@index([memberId, status])
  @@index([scheduledFor])
}

// ------------------------------------------------- kept, lightly extended

model ShoppingItem {
  id        Int           @id @default(autoincrement())
  name      String
  quantity  String?
  store     String?
  checked   Boolean       @default(false)
  position  Int           @default(0)
  addedById Int?
  addedBy   FamilyMember? @relation(fields: [addedById], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
}

model Meal {
  id         Int       @id @default(autoincrement())
  name       String
  notes      String?
  plannedFor DateTime?
  createdAt  DateTime  @default(now())
}

// ----------------------------------------------------- audit and syncing

/// Added early on purpose: retrofitting an audit trail once several people
/// and two-way sync are all writing the same rows is painful.
model ActivityLog {
  id        Int           @id @default(autoincrement())
  memberId  Int?
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// e.g. task.complete, event.create, sync.microsoft
  action    String
  entity    String
  entityId  Int?
  detail    Json?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

model SyncRun {
  id         Int       @id @default(autoincrement())
  provider   Source
  /// calendar | tasks
  kind       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  itemsIn    Int       @default(0)
  itemsOut   Int       @default(0)
  error      String?

  @@index([startedAt])
}

// ------------------------------------------------------- notifications

enum NoticeKind {
  /// Written by a person: "we're eating at the Hales' tonight".
  FAMILY_NOTICE
  /// Generated from a change: "Rhian moved Family dinner".
  CHANGE
}

model Notification {
  id       Int        @id @default(autoincrement())
  kind     NoticeKind @default(FAMILY_NOTICE)
  title    String
  body     String?
  /// Who it is for. Null means the whole family, which is the usual case.
  memberId Int?
  member   FamilyMember? @relation("NoticeFor", fields: [memberId], references: [id], onDelete: Cascade)
  /// Who caused it. Null for anything the system raised on its own.
  authorId Int?
  author   FamilyMember? @relation("NoticeBy", fields: [authorId], references: [id], onDelete: SetNull)
  /// What it is about, so a notice can link back to the thing that changed.
  entity   String?
  entityId Int?
  createdAt DateTime @default(now())

  reads NotificationRead[]

  @@index([createdAt])
  @@index([memberId, createdAt])
}

/// Read state is per person, which is what lets the card say "everyone is
/// up to date" rather than merely "nothing new for you".
model NotificationRead {
  id             Int          @id @default(autoincrement())
  notificationId Int
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  memberId       Int
  member         FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([notificationId, memberId])
}

// ------------------------------------------------------------ push reminders

/// One row per device that has turned on reminders. A person can have
/// several (phone, tablet, laptop). Created by the device itself from
/// Settings -> Reminders, never typed in.
model PushSubscription {
  id         Int          @id @default(autoincrement())
  memberId   Int
  member     FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint   String
  p256dh     String
  auth       String
  /// Friendly name shown in Settings, e.g. "Jack's phone".
  label      String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())

  @@unique([memberId, endpoint])
}

enum ReminderItemType {
  EVENT
  TASK
}

/// One row per reminder actually sent. The unique constraint is what stops
/// a person being reminded twice about the same occurrence - including
/// each occurrence of a recurring series, and if two server copies run.
model ReminderLog {
  id        Int              @id @default(autoincrement())
  memberId  Int
  member    FamilyMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  itemType  ReminderItemType
  itemId    Int
  occursAt  DateTime
  sentAt    DateTime         @default(now())

  @@unique([memberId, itemType, itemId, occursAt])
  @@index([sentAt])
}

/// Family-wide settings that belong to the family, not to Railway.
/// Always a single row, id = 1.
model FamilySetting {
  id               Int      @id @default(1)
  reminderLeadMins Int      @default(30)
  /// Local time in FAMILY_TIMEZONE, "HH:MM". No pushes between these.
  quietStart       String   @default("21:30")
  quietEnd         String   @default("06:30")
  updatedAt        DateTime @updatedAt
}
